// What each monster leaves when it dies. Every line rolls on its own; gear that drops is fine
// with `fine_chance` (default 0.05). Summoned monsters drop nothing.
(
    loot: [
        (mob: "wolf", coins: (0, 3), drops: [
            (item: "wolf_pelt", chance: 0.6),
        ]),
        (mob: "dire_wolf", coins: (2, 8), drops: [
            (item: "dire_pelt", chance: 0.7),
            (item: "wolf_pelt", chance: 0.4, count: (1, 2)),
        ]),
        (mob: "goblin", coins: (3, 9), drops: [
            (item: "goblin_trinket", chance: 0.35),
            (item: "goblin_cap", chance: 0.08),
            (item: "dagger.hunting", chance: 0.05),
            (item: "copper_ore", chance: 0.2, count: (1, 3)),
        ]),
        (mob: "goblin_archer", coins: (3, 9), drops: [
            (item: "goblin_trinket", chance: 0.35),
            (item: "bow.hunting", chance: 0.05),
        ]),
        (mob: "skeleton", coins: (2, 6), drops: [
            (item: "bone_dust", chance: 0.8, count: (1, 3)),
            (item: "sword.arming", chance: 0.04),
        ]),
        (mob: "golem", coins: (20, 40), drops: [
            (item: "golem_core", chance: 1.0),
            (item: "iron_ore", chance: 0.6, count: (2, 5)),
            (item: "mace.flanged", chance: 0.15),
        ], fine_chance: 0.15),
        (mob: "barrow_king", coins: (120, 200), drops: [
            (item: "barrow_crown", chance: 1.0),
            (item: "sword.great", chance: 0.5),
            (item: "shield.kite", chance: 0.5),
        ], fine_chance: 0.25),
    ],
)
