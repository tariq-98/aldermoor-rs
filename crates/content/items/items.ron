        (key: "leather_jerkin", name: "Leather Jerkin", kind: Armour, value: 45, stats: (armor: 25.0), tags: ["armour", "hide"]),
        (key: "goblin_cap", name: "Goblin Cap", kind: Armour, value: 20, stats: (armor: 8.0), tags: ["armour", "hide"]),
        (key: "barrow_crown", name: "Crown of the Barrow King", kind: Armour, tier: 2, value: 600, stats: (armor: 40.0, power: 4.0, health: 40.0), tags: ["armour", "metal"]),

