// Every item, with its fixed stats and its price (what a shop sells it for; shops pay
// SELL_SHARE of it, more where the town wants it). Gear is one to a slot; materials stack.
// Fine versions add FINE_BONUS to the stats and sell for FINE_VALUE times as much
// (crates/content/src/items.rs). Weapon keys are the gear catalogue's and the combat tables'.
(
    items: [
        // Weapons, tier 1. Stats are what wielding one adds (gear isn't applied to fights yet, #17).
        (key: "sword.arming", name: "Arming Sword", kind: Weapon, value: 40, stats: (power: 4.0), tags: ["weapon", "metal"]),
        (key: "sword.great", name: "Greatsword", kind: Weapon, value: 70, stats: (power: 7.0), tags: ["weapon", "metal"]),
        (key: "axe.bearded", name: "Bearded Axe", kind: Weapon, value: 45, stats: (power: 4.5), tags: ["weapon", "metal"]),
        (key: "mace.flanged", name: "Flanged Mace", kind: Weapon, value: 45, stats: (power: 4.5), tags: ["weapon", "metal"]),
        (key: "dagger.hunting", name: "Hunting Dagger", kind: Weapon, value: 25, stats: (power: 2.5), tags: ["weapon", "metal"]),
        (key: "spear.ash", name: "Ash Spear", kind: Weapon, value: 50, stats: (power: 6.0), tags: ["weapon", "wood"]),
        (key: "bow.hunting", name: "Hunting Bow", kind: Weapon, value: 45, stats: (power: 5.0), tags: ["weapon", "wood"]),
        (key: "bow.long", name: "Longbow", kind: Weapon, value: 75, stats: (power: 7.0), tags: ["weapon", "wood"]),
        (key: "staff.oak", name: "Oak Staff", kind: Weapon, value: 60, stats: (power: 6.5), tags: ["weapon", "wood"]),
        (key: "staff.healer", name: "Healer's Staff", kind: Weapon, value: 60, stats: (power: 6.5), tags: ["weapon", "wood"]),
        (key: "staff.necro", name: "Bone Staff", kind: Weapon, value: 60, stats: (power: 6.5), tags: ["weapon", "wood"]),
        (key: "wand.yew", name: "Yew Wand", kind: Weapon, value: 35, stats: (power: 3.5), tags: ["weapon", "wood"]),
        (key: "orb.focus", name: "Focus Orb", kind: Weapon, value: 35, stats: (power: 2.0, health: 10.0), tags: ["weapon"]),
        (key: "book.spells", name: "Spellbook", kind: Weapon, value: 35, stats: (power: 2.0, health: 10.0), tags: ["weapon"]),
        (key: "shield.round", name: "Round Shield", kind: Weapon, value: 35, stats: (armor: 20.0), tags: ["weapon", "wood"]),
        (key: "shield.kite", name: "Kite Shield", kind: Weapon, value: 55, stats: (armor: 30.0), tags: ["weapon", "metal"]),

