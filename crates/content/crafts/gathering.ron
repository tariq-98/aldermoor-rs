    tools: [
        (item: "pickaxe.copper", skill: Mining, speed: 1.0),
        (item: "pickaxe.iron", skill: Mining, level: 10, speed: 1.4),
        (item: "hatchet.copper", skill: Woodcutting, speed: 1.0),
        (item: "hatchet.iron", skill: Woodcutting, level: 10, speed: 1.4),
        (item: "knife.skinning", skill: Skinning, speed: 1.0),
        (item: "sickle.copper", skill: Herbalism, speed: 1.0),
